{
  "redirects": [
    {
      "source": "/admin/accounts",
      "destination": "https://admin.athanext.com/users",
      "permanent": false
    },
    {
      "source": "/admin/referrals",
      "destination": "https://admin.athanext.com/referrals",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://admin.athanext.com/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.athanext.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:coach([^/.]+)/:camp([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|WhatsApp|TelegramBot|LinkedInBot|SkypeUriPreview|Pinterestbot|redditbot|Embedly|iMessageLinkPreview|Applebot).*"
        }
      ],
      "destination": "/api/camp-preview?coach=:coach&camp=:camp"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
